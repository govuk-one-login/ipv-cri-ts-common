{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "ipv-cri-ts-common",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "code style and linting",
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-repo.yml",
            "path": "$.jobs.run-pre-commit"
          }
        },
        {
          "checkTypes": [
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-repo.yml",
            "path": "$.jobs.unit-tests"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit test coverage",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-repo.yml",
            "path": "$.jobs.sonarcloud"
          }
        },
        {
          "checkTypes": [
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-repo.yml",
            "path": "$.jobs.codeql"
          }
        },
        {
          "checkTypes": [
            "integration",
            "regression",
            "new feature"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/check-repo.yml",
            "path": "$.jobs.integration-tests"
          }
        }
      ]
    }
  ]
}
