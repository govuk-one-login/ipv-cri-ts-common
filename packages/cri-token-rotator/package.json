{
  "name": "@govuk-one-login/cri-token-rotator",
  "version": "0.1.0",
  "description": "Library functions for async access token management",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/ipv-cri-ts-common.git",
    "directory": "packages/cri-token-rotator"
  },
  "scripts": {
    "build:cjs": "npx tsc --outDir dist/cjs --module commonjs --moduleResolution node10",
    "build:esm": "npx tsc --outDir dist/esm",
    "build": "npm run build:esm && npm run build:cjs",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "lint": "npx eslint"
  },
  "peerDependencies": {
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@govuk-one-login/cri-logger": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    }
  },
  "files": [
    "./dist"
  ],
  "module": "./dist/esm/index.js",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "dynamodb": [
        "./dist/cjs/dynamodb.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./dynamodb": {
      "import": {
        "types": "./dist/esm/dynamodb.d.ts",
        "default": "./dist/esm/dynamodb.js"
      },
      "require": {
        "types": "./dist/cjs/dynamodb.d.ts",
        "default": "./dist/cjs/dynamodb.js"
      }
    }
  }
}
