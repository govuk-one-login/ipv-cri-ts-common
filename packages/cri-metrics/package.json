{
  "name": "@govuk-one-login/cri-metrics",
  "version": "1.0.2",
  "description": "",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/ipv-cri-ts-common.git",
    "directory": "packages/cri-metrics"
  },
  "scripts": {
    "build:cjs": "npx tsc --outDir dist/cjs --module commonjs --moduleResolution node10",
    "build:esm": "npx tsc --outDir dist/esm",
    "build": "npm run build:esm && npm run build:cjs",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "lint": "npx eslint",
    "test:integration:deploy": "./integration-tests/deploy.sh",
    "test:integration:run": "npx vitest run --config integration-tests/vitest.config.ts",
    "test:integration:clean": "./integration-tests/clean.sh",
    "test:integration": "STACK_NAME=\"TSCommon-Metrics-TestStack-$STACK_IDENTIFIER\" RUN_ID=\"$(openssl rand -base64 3)\" npm-run-all test:integration:deploy test:integration:run test:integration:clean --serial --continue-on-error"
  },
  "files": [
    "./dist"
  ],
  "module": "./dist/esm/index.js",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "peerDependencies": {
    "@aws-lambda-powertools/metrics": "^2.28.1",
    "@govuk-one-login/cri-logger": "^1.0.0"
  },
  "devDependencies": {
    "@govuk-one-login/cri-test-metrics-helpers": "1.0.2"
  }
}
